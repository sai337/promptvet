{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'stdlib only, nothing to install'",
  "buildCommand": "python3 scripts/build_report.py",
  "outputDirectory": "public",
  "functions": {
    "api/scan.py": { "includeFiles": "promptvet/**", "maxDuration": 30 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
